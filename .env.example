# Vercel / Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional: altere se quiser usar outro remetente ou destinatário.
# O domínio do email remetente precisa estar verificado no Resend.
RESEND_FROM_EMAIL=contato@vainaai.pt
RESEND_TO_EMAIL=contato@vainaai.pt

# SGI-FV - Integração cadastro externo (wix-client-intake)
VITE_SGI_FV_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
VITE_SGI_FV_ANON_KEY=SUA_SUPABASE_ANON_KEY
VITE_SGI_FV_API_KEY=SUA_CHAVE_PRIVADA_DA_INTEGRACAO
VITE_SGI_FV_SOURCE=vainaai-site
VITE_SGI_FV_SITE_NAME=VainAAI
VITE_SGI_FV_ORG_SLUG=default
